# CelebiPlug — chat-native bootstrap
#
# Copy this file to .env and set your Mapbox **public** token (pk....).
# An agent can also write this file directly on first install:
#
#   echo 'MAPBOX_TOKEN=pk.eyJ1...' > .env
#
# On the next page load app.py reads this token, the page seeds it into
# localStorage, and the welcome screen is skipped. Only pk. tokens are
# accepted. Never put an sk. (secret) token here.
#
# This file is .gitignored — your token never leaves the machine.

MAPBOX_TOKEN=pk.replace-me
