# CelebiPlug — chat-native bootstrap
#
# Copy this file to .env and set your Mapbox **public** token (pk....).
# An agent can also write this file directly on first install:
#
#   echo 'MAPBOX_TOKEN=pk.eyJ1...' > .env
#
# On the next page load app.py reads this token, the page seeds it into
# localStorage, and the welcome screen is skipped. Only pk. tokens are
# accepted. Never put an sk. (secret) token here.
#
# This file is .gitignored — your token never leaves the machine.

MAPBOX_TOKEN=pk.replace-me

# ---------------------------------------------------------------------------
# Geo-intelligence modules. All defaults are token-free; the keys below are
# only needed if you want to switch providers. Leave anything you do not use
# empty and CelebiPlug falls back to the free public source.
# ---------------------------------------------------------------------------

# Geocoder used by the API/CLI when resolving city names.
# CELEBI_GEOCODER=osm              # osm | mapbox

# Weather
# CELEBI_WEATHER_PROVIDER=open-meteo   # open-meteo | openweather
# OPENWEATHER_API_KEY=

# News
# CELEBI_NEWS_PROVIDER=rss             # rss | newsapi
# NEWSAPI_KEY=

# Aircraft
# CELEBI_AIRCRAFT_PROVIDER=opensky     # opensky | adsb-lol
# OPENSKY_USERNAME=
# OPENSKY_PASSWORD=

# Earthquake provider chain (first that returns data wins)
# CELEBI_EARTHQUAKE_PROVIDERS=afad,kandilli,usgs

# Wildfire — optional FIRMS MAP_KEY for higher-rate access; CSVs work without
# FIRMS_MAP_KEY=
